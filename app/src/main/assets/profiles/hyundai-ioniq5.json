{
  "id": "hyundai-ioniq5",
  "name": "Hyundai Ioniq 5 (2022–2024, E-GMP)",
  "notes": "Community-published PIDs (Esprit1st/Hyundai-Ioniq-5-Torque-Pro-PIDs, based on JejuSoul/OBD-PIDs-for-HKMC-EVs). Not verified by dreyev on a car yet. Brake pressure, wheel speeds, turn signals and seatbelts are not in the published list.",
  "powertrain": "ev",
  "wmi": ["KM8KM", "KM8KN", "KM8KR", "KM8KS"],
  "brakes": { "frontPistonAreaCm2": 25.5, "rearPistonAreaCm2": 11.3 },
  "signals": [
    { "signal": "tirePressureFL", "header": "7A0", "request": "22C00B", "formula": "E/5",  "unit": "psi", "intervalMs": 5000 },
    { "signal": "tirePressureFR", "header": "7A0", "request": "22C00B", "formula": "J/5",  "unit": "psi", "intervalMs": 5000 },
    { "signal": "tirePressureRL", "header": "7A0", "request": "22C00B", "formula": "O/5",  "unit": "psi", "intervalMs": 5000 },
    { "signal": "tirePressureRR", "header": "7A0", "request": "22C00B", "formula": "T/5",  "unit": "psi", "intervalMs": 5000 },
    { "signal": "tireTempFL",     "header": "7A0", "request": "22C00B", "formula": "F-50", "unit": "C",   "intervalMs": 5000 },
    { "signal": "tireTempFR",     "header": "7A0", "request": "22C00B", "formula": "K-50", "unit": "C",   "intervalMs": 5000 },
    { "signal": "tireTempRL",     "header": "7A0", "request": "22C00B", "formula": "P-50", "unit": "C",   "intervalMs": 5000 },
    { "signal": "tireTempRR",     "header": "7A0", "request": "22C00B", "formula": "U-50", "unit": "C",   "intervalMs": 5000 },

    { "signal": "steeringAngle",  "header": "730", "request": "22F010", "formula": "signed(N*256+M,16)/10", "unit": "deg", "intervalMs": 150 },

    { "signal": "vehicleSpeed",   "header": "7B3", "request": "220100", "formula": "AD",      "unit": "km/h", "intervalMs": 200 },
    { "signal": "ambientTemp",    "header": "7B3", "request": "220100", "formula": "G/2-40",  "unit": "C",    "intervalMs": 200 },

    { "signal": "odometer",       "header": "7C6", "request": "22B002", "formula": "G*65536+H*256+I", "unit": "km", "intervalMs": 60000 },

    { "signal": "ready",          "header": "7E4", "request": "220101", "formula": "bit(AY,2)", "intervalMs": 400 },
    { "signal": "batteryCurrent", "header": "7E4", "request": "220101", "formula": "signed(K*256+L,16)/10", "unit": "A", "intervalMs": 400 },
    { "signal": "batteryVoltage", "header": "7E4", "request": "220101", "formula": "(M*256+N)/10", "unit": "V", "intervalMs": 400 },
    { "signal": "motorRpmRear",   "header": "7E4", "request": "220101", "formula": "signed(BB*256+BC,16)", "unit": "rpm", "intervalMs": 400 },
    { "signal": "motorRpmFront",  "header": "7E4", "request": "220101", "formula": "signed(BD*256+BE,16)", "unit": "rpm", "intervalMs": 400 },
    { "signal": "auxBatteryVoltage", "header": "7E4", "request": "220101", "formula": "AD/10", "unit": "V", "intervalMs": 400 },

    { "signal": "batterySoc",     "header": "7E4", "request": "220105", "formula": "AF/2", "unit": "%", "intervalMs": 10000 }
  ]
}
